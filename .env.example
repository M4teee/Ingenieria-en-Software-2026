# Copiá este archivo como `.env` en la raíz del repositorio (no se versiona).

# Clave secreta de Django. Si queda vacía o comentada se usa una clave
# de desarrollo local. Para generar una:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Base de datos. Vacía: SQLite local en Backend/db.sqlite3.
# PostgreSQL (por ejemplo, Neon): connection string completo.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
DATABASE_URL=
